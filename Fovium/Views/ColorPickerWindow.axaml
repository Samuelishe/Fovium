<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Fovium.Views"
        x:Class="Fovium.Views.ColorPickerWindow"
        Classes="fovium-secondary-window"
        Width="610"
        Height="690"
        CanResize="False"
        Background="Transparent">
    <Window.Styles>
        <Style Selector="TextBox.channel-input">
            <Setter Property="Width" Value="104" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Border Margin="1" Padding="{StaticResource FoviumDialogPadding}"
            Classes="fovium-window-surface">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="PickerTitle" Classes="dialog-title" />
                    <TextBlock x:Name="PickerDescription" Classes="supporting" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Classes="window-close" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,52" ColumnSpacing="22"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:ColorWheelControl x:Name="ColorWheel" Width="330" Height="330" />
                <views:ColorValueStripControl x:Name="ValueStrip" Grid.Column="1" Width="38" Height="330" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RgbModeButton" Classes="fovium-button segmented" Content="RGB" />
                    <Button x:Name="HsvModeButton" Classes="fovium-button segmented" Content="HSV" />
                    <Button x:Name="HexModeButton" Classes="fovium-button segmented" Content="HEX" />
                </StackPanel>
                <TextBlock x:Name="ValidationText" Grid.Column="1" Foreground="{StaticResource FoviumWarningBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="3" Padding="16,14" Classes="fovium-card">
                <Grid>
                    <Grid x:Name="RgbPanel" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="9" HorizontalAlignment="Center">
                        <TextBlock Text="R" VerticalAlignment="Center" />
                        <TextBox x:Name="RedValue" Grid.Column="1" Classes="channel-input" MaxLength="3" />
                        <TextBlock Grid.Column="2" Text="G" VerticalAlignment="Center" />
                        <TextBox x:Name="GreenValue" Grid.Column="3" Classes="channel-input" MaxLength="3" />
                        <TextBlock Grid.Column="4" Text="B" VerticalAlignment="Center" />
                        <TextBox x:Name="BlueValue" Grid.Column="5" Classes="channel-input" MaxLength="3" />
                    </Grid>
                    <Grid x:Name="HsvPanel" IsVisible="False"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="9" HorizontalAlignment="Center">
                        <TextBlock Text="H°" VerticalAlignment="Center" />
                        <TextBox x:Name="HueValue" Grid.Column="1" Classes="channel-input" MaxLength="7" />
                        <TextBlock Grid.Column="2" Text="S%" VerticalAlignment="Center" />
                        <TextBox x:Name="SaturationValue" Grid.Column="3" Classes="channel-input" MaxLength="7" />
                        <TextBlock Grid.Column="4" Text="V%" VerticalAlignment="Center" />
                        <TextBox x:Name="BrightnessValue" Grid.Column="5" Classes="channel-input" MaxLength="7" />
                    </Grid>
                    <Grid x:Name="HexPanel" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock x:Name="HexLabel" VerticalAlignment="Center" />
                        <TextBox x:Name="HexValue" Grid.Column="1" MaxLength="7" FontFamily="Consolas"
                                 HorizontalContentAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="OriginalLabel" Classes="caption" />
                    <Border x:Name="OriginalPreview" Width="70" Height="34" CornerRadius="6"
                            BorderBrush="{StaticResource FoviumBorderInteractiveBrush}" BorderThickness="1" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" Margin="4,20,4,0"
                           Foreground="{StaticResource FoviumTextSecondaryBrush}"
                           FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Left">
                    <TextBlock x:Name="CurrentLabel" Classes="caption" />
                    <Border x:Name="CurrentPreview" Width="70" Height="34" CornerRadius="6"
                            BorderBrush="{StaticResource FoviumFocusRingBrush}" BorderThickness="1" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="3" MinWidth="94" VerticalAlignment="Bottom"
                        Classes="fovium-button" />
                <Button x:Name="OkButton" Grid.Column="4" MinWidth="94" VerticalAlignment="Bottom"
                        Classes="fovium-button primary" />
            </Grid>
        </Grid>
    </Border>
</Window>