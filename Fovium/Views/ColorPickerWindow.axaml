<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Fovium.Views"
        x:Class="Fovium.Views.ColorPickerWindow"
        Width="610"
        Height="690"
        CanResize="False"
        Background="#17151C"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Button.window-close">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#292530" />
            <Setter Property="BorderBrush" Value="#403A49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.window-close:pointerover">
            <Setter Property="Background" Value="#55313A" />
            <Setter Property="BorderBrush" Value="#80505B" />
        </Style>
        <Style Selector="Button.mode-button">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Background" Value="#2B2732" />
            <Setter Property="BorderBrush" Value="#413B49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.mode-button:selected">
            <Setter Property="Background" Value="#594066" />
            <Setter Property="BorderBrush" Value="#8A62A0" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#6F4E80" />
            <Setter Property="BorderBrush" Value="#9A70AE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="#805C92" />
        </Style>
        <Style Selector="TextBox.channel-input">
            <Setter Property="Width" Value="104" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Border Margin="1" Padding="26,22,26,24" Background="#1C1922"
            BorderBrush="#3C3644" BorderThickness="1" CornerRadius="14">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="PickerTitle" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="PickerDescription" Foreground="#AFA8B8" FontSize="13" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Classes="window-close" Content="×" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,52" ColumnSpacing="22"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:ColorWheelControl x:Name="ColorWheel" Width="330" Height="330" />
                <views:ColorValueStripControl x:Name="ValueStrip" Grid.Column="1" Width="38" Height="330" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RgbModeButton" Classes="mode-button" Content="RGB" />
                    <Button x:Name="HsvModeButton" Classes="mode-button" Content="HSV" />
                    <Button x:Name="HexModeButton" Classes="mode-button" Content="HEX" />
                </StackPanel>
                <TextBlock x:Name="ValidationText" Grid.Column="1" Foreground="#FFE57373"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="3" Padding="16,14" Background="#24212B" BorderBrush="#37333F"
                    BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid x:Name="RgbPanel" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="9" HorizontalAlignment="Center">
                        <TextBlock Text="R" VerticalAlignment="Center" />
                        <TextBox x:Name="RedValue" Grid.Column="1" Classes="channel-input" MaxLength="3" />
                        <TextBlock Grid.Column="2" Text="G" VerticalAlignment="Center" />
                        <TextBox x:Name="GreenValue" Grid.Column="3" Classes="channel-input" MaxLength="3" />
                        <TextBlock Grid.Column="4" Text="B" VerticalAlignment="Center" />
                        <TextBox x:Name="BlueValue" Grid.Column="5" Classes="channel-input" MaxLength="3" />
                    </Grid>
                    <Grid x:Name="HsvPanel" IsVisible="False"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="9" HorizontalAlignment="Center">
                        <TextBlock Text="H°" VerticalAlignment="Center" />
                        <TextBox x:Name="HueValue" Grid.Column="1" Classes="channel-input" MaxLength="7" />
                        <TextBlock Grid.Column="2" Text="S%" VerticalAlignment="Center" />
                        <TextBox x:Name="SaturationValue" Grid.Column="3" Classes="channel-input" MaxLength="7" />
                        <TextBlock Grid.Column="4" Text="V%" VerticalAlignment="Center" />
                        <TextBox x:Name="BrightnessValue" Grid.Column="5" Classes="channel-input" MaxLength="7" />
                    </Grid>
                    <Grid x:Name="HexPanel" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock x:Name="HexLabel" VerticalAlignment="Center" />
                        <TextBox x:Name="HexValue" Grid.Column="1" MaxLength="7" FontFamily="Consolas"
                                 HorizontalContentAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="OriginalLabel" Foreground="#AAA4B3" FontSize="12" />
                    <Border x:Name="OriginalPreview" Width="70" Height="34" CornerRadius="6"
                            BorderBrush="#5B5364" BorderThickness="1" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" Margin="4,20,4,0" Foreground="#8D8497"
                           FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Left">
                    <TextBlock x:Name="CurrentLabel" Foreground="#AAA4B3" FontSize="12" />
                    <Border x:Name="CurrentPreview" Width="70" Height="34" CornerRadius="6"
                            BorderBrush="#8A62A0" BorderThickness="1" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="3" MinWidth="94" VerticalAlignment="Bottom" />
                <Button x:Name="OkButton" Grid.Column="4" MinWidth="94" VerticalAlignment="Bottom"
                        Classes="accent" />
            </Grid>
        </Grid>
    </Border>
</Window>