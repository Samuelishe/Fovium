<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="using:Fovium.Viewer"
        xmlns:views="using:Fovium.Views"
        x:Class="Fovium.Views.ViewerWindow"
        Title="Fovium"
        Background="Black"
        WindowState="Maximized"
        MinWidth="480"
        MinHeight="320">
    <Window.Styles>
        <Style Selector="Button.home-primary">
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#8354E8" />
            <Setter Property="BorderBrush" Value="#A982FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.home-primary:pointerover">
            <Setter Property="Background" Value="#9466F0" />
            <Setter Property="BorderBrush" Value="#C0A3FF" />
        </Style>
        <Style Selector="Button.home-secondary">
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#2B2734" />
            <Setter Property="BorderBrush" Value="#494252" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.home-secondary:pointerover">
            <Setter Property="Background" Value="#393242" />
            <Setter Property="BorderBrush" Value="#665B73" />
        </Style>
        <Style Selector="Button.home-icon">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Background" Value="#25212C" />
            <Setter Property="BorderBrush" Value="#3C3645" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.home-icon:pointerover">
            <Setter Property="Background" Value="#362E41" />
            <Setter Property="BorderBrush" Value="#6D5687" />
        </Style>
        <Style Selector="Button.home-link">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C8A8F4" />
        </Style>
        <Style Selector="Button.home-link:pointerover">
            <Setter Property="Foreground" Value="#E7D7FF" />
            <Setter Property="Background" Value="#24202C" />
        </Style>
        <Style Selector="Button.recent-card">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="154" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#B31E1A25" />
            <Setter Property="BorderBrush" Value="#42394C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>
        <Style Selector="Button.recent-card:pointerover">
            <Setter Property="Background" Value="#D1292333" />
            <Setter Property="BorderBrush" Value="#765993" />
        </Style>
        <Style Selector="Button.recent-card.unavailable">
            <Setter Property="Opacity" Value="0.52" />
        </Style>
        <Style Selector="Button.recent-item-action">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#B31B1720" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style Selector="Button.recent-item-action:pointerover">
            <Setter Property="Background" Value="#E044374F" />
        </Style>
        <Style Selector="Border.home-hero.drag-ready">
            <Setter Property="BorderBrush" Value="#C099FF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="#ED252032" />
        </Style>
    </Window.Styles>
    <Grid x:Name="ViewerRoot" Background="Black">
        <viewer:PhotoViewportControl x:Name="PhotoViewport" />
        <Border x:Name="HomeSurface" ZIndex="3" Background="#121017">
            <Grid ClipToBounds="True">
                <Ellipse Width="900" Height="760"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-390,-390,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#45386F" />
                            <GradientStop Offset="0.5" Color="#1D1830" />
                            <GradientStop Offset="1" Color="#00121017" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="820" Height="700"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-360,-370" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#402947" />
                            <GradientStop Offset="0.52" Color="#1B1422" />
                            <GradientStop Offset="1" Color="#00121017" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Button x:Name="HomeSettingsButton"
                        ZIndex="5"
                        Classes="home-icon"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,18,24,0" />
                <Grid x:Name="HomeComposition"
                      Margin="24,58,24,26"
                      RowDefinitions="*,Auto,Auto,*">
                    <Border x:Name="HomeHeroCard"
                            Grid.Row="1"
                            Classes="home-hero"
                            MaxWidth="800"
                            MinHeight="370"
                            HorizontalAlignment="Stretch"
                            Padding="26,22,26,23"
                            CornerRadius="26"
                            Background="#D91C1924"
                            BorderBrush="#53465F"
                            BorderThickness="1"
                            BoxShadow="0 18 50 0 #52000000">
                        <Grid x:Name="HomeHeroLayout"
                              RowDefinitions="132,Auto,Auto,Auto,Auto"
                              RowSpacing="9">
                            <Canvas x:Name="HomeHeroVisual"
                                    Grid.Row="0"
                                    Width="270"
                                    Height="126"
                                    HorizontalAlignment="Center">
                                <Ellipse Canvas.Left="63" Canvas.Top="-8"
                                         Width="144" Height="144"
                                         Stroke="#433C4E" StrokeThickness="1" />
                                <Border Canvas.Left="25" Canvas.Top="34"
                                        Width="92" Height="76"
                                        CornerRadius="12"
                                        Background="#242E3F"
                                        BorderBrush="#44536A"
                                        BorderThickness="1"
                                        RenderTransformOrigin="50%,50%">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-10" />
                                    </Border.RenderTransform>
                                    <Grid ClipToBounds="True">
                                        <Ellipse Width="58" Height="58" Margin="-18,-22,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Fill="#405974" Opacity="0.8" />
                                        <Path Data="M0,64 L27,33 L43,48 L61,25 L92,58 L92,76 L0,76 Z"
                                              Fill="#151B27" />
                                    </Grid>
                                </Border>
                                <Border Canvas.Left="153" Canvas.Top="34"
                                        Width="92" Height="76"
                                        CornerRadius="12"
                                        Background="#3A2B41"
                                        BorderBrush="#5C4667"
                                        BorderThickness="1"
                                        RenderTransformOrigin="50%,50%">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="10" />
                                    </Border.RenderTransform>
                                    <Grid ClipToBounds="True">
                                        <Ellipse Width="68" Height="68" Margin="34,-28,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Fill="#684067" Opacity="0.75" />
                                        <Path Data="M0,62 L25,38 L43,50 L65,24 L92,56 L92,76 L0,76 Z"
                                              Fill="#201823" />
                                    </Grid>
                                </Border>
                                <Border Canvas.Left="87" Canvas.Top="15"
                                        Width="98" Height="96"
                                        CornerRadius="14"
                                        Background="#573985"
                                        BorderBrush="#A877F1"
                                        BorderThickness="1.5">
                                    <Grid ClipToBounds="True">
                                        <Ellipse Width="76" Height="76" Margin="34,-29,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Fill="#A35EAE" Opacity="0.75" />
                                        <Path Data="M0,79 L25,50 L42,61 L64,28 L98,68 L98,96 L0,96 Z"
                                              Fill="#20172A" />
                                        <Path Data="M20,75 L45,49 L55,60 L74,43 L92,70"
                                              Stroke="#D5A5EF" StrokeThickness="2" Opacity="0.55" />
                                    </Grid>
                                </Border>
                            </Canvas>
                            <TextBlock x:Name="HomeTitleText"
                                       Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="35"
                                       FontWeight="SemiBold"
                                       Foreground="#F5F1F8" />
                            <StackPanel Grid.Row="2" Spacing="4">
                                <TextBlock x:Name="HomeSubtitleText"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Foreground="#C0B8C8" />
                                <TextBlock x:Name="HomeDropHintText"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#918999" />
                            </StackPanel>
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button x:Name="HomeOpenFilesButton"
                                        Classes="home-primary"
                                        Margin="5" />
                                <Button x:Name="HomeOpenFolderButton"
                                        Classes="home-secondary"
                                        Margin="5" />
                            </StackPanel>
                            <StackPanel x:Name="HomeShortcutHint"
                                        Grid.Row="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="7">
                                <Border Padding="7,3"
                                        CornerRadius="5"
                                        Background="#2B2632"
                                        BorderBrush="#463E4E"
                                        BorderThickness="1">
                                    <TextBlock x:Name="HomeShortcutGestureText"
                                               FontSize="11"
                                               Foreground="#D9D0E0" />
                                </Border>
                                <TextBlock x:Name="HomeShortcutActionText"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#827A8B" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid x:Name="HomeRecentSection"
                          Grid.Row="2"
                          IsVisible="False"
                          MaxWidth="1240"
                          Margin="0,20,0,0"
                          RowDefinitions="Auto,154">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,9">
                            <TextBlock x:Name="HomeRecentTitleText"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="HomeClearRecentButton"
                                    Grid.Column="1"
                                    Classes="home-link" />
                        </Grid>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <ScrollViewer x:Name="HomeRecentScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="HomeRecentItemsPanel"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left" />
                            </ScrollViewer>
                            <Border x:Name="HomeRecentLeftFade"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    Width="42"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Offset="0" Color="#F0121017" />
                                        <GradientStop Offset="1" Color="#00121017" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="HomeRecentRightFade"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    Width="42"
                                    HorizontalAlignment="Right">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Offset="0" Color="#00121017" />
                                        <GradientStop Offset="1" Color="#F0121017" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <viewer:MarkupOverlayControl x:Name="MarkupOverlay" />
        <viewer:PointerFeedbackOverlayControl x:Name="PointerFeedbackOverlay" />
        <Border x:Name="MarkupToolsPanel"
                IsVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="8"
                CornerRadius="7"
                Background="#E6202020"
                BorderBrush="#604A4A4A"
                BorderThickness="1">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border x:Name="MarkupDragHandle"
                            Width="18"
                            Height="30"
                            Cursor="SizeAll"
                            Background="Transparent"
                            CornerRadius="3">
                        <TextBlock Text="⠿"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </Border>
                    <Button x:Name="MarkupHandButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupBrushButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupEraserButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupLineButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupRectangleButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupEllipseButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupArrowButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Separator Width="1" Margin="3,2" />
                    <Button x:Name="MarkupUndoButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupRedoButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Button x:Name="MarkupClearButton" Width="32" Height="30" Padding="6" Focusable="False" />
                    <Separator Width="1" Margin="3,2" />
                    <Button x:Name="MarkupCloseButton" Width="26" Height="30" Padding="5" Focusable="False" />
                </StackPanel>
                <Separator Height="1" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="MarkupColorButton" Width="36" Height="28" Padding="6" Focusable="False">
                        <Border x:Name="MarkupColorSwatch"
                                Width="18" Height="18" CornerRadius="3" />
                    </Button>
                    <TextBlock x:Name="MarkupStrokeText"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0" />
                    <Slider x:Name="MarkupStrokeSlider"
                            Focusable="False"
                            Width="104"
                            Minimum="1"
                            Maximum="128"
                            TickFrequency="1" />
                    <TextBlock x:Name="MarkupStrokeValue"
                               Width="30"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MarkupOpacityText"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0" />
                    <Slider x:Name="MarkupOpacitySlider"
                            Focusable="False"
                            Width="92"
                            Minimum="5"
                            Maximum="100"
                            TickFrequency="5" />
                    <TextBlock x:Name="MarkupOpacityValue"
                               Width="38"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="PhotoInfoPanel"
                IsVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="440"
                MaxWidth="500"
                Padding="10,8,10,10"
                CornerRadius="8"
                Background="#E6202020"
                BorderBrush="#604A4A4A"
                BorderThickness="1">
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                    <Border x:Name="PhotoInfoDragHandle"
                            Grid.Column="0"
                            Width="22"
                            Cursor="SizeAll"
                            Background="Transparent"
                            CornerRadius="3">
                        <TextBlock Text="⠿"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </Border>
                    <TextBlock x:Name="PhotoInfoTitleText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Opacity="0.88" />
                    <Button x:Name="PhotoInfoCloseButton"
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            Padding="5"
                            Focusable="False" />
                </Grid>
                <StackPanel x:Name="PhotoInfoRows" Spacing="3" />
            </StackPanel>
        </Border>
        <Border x:Name="HistogramPanel"
                IsVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="320"
                Height="212"
                Padding="10,8,10,10"
                CornerRadius="8"
                Background="#E6202020"
                BorderBrush="#604A4A4A"
                BorderThickness="1">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                    <Border x:Name="HistogramDragHandle"
                            Grid.Column="0"
                            Width="22"
                            Cursor="SizeAll"
                            Background="Transparent"
                            CornerRadius="3">
                        <TextBlock Text="⠿"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </Border>
                    <TextBlock x:Name="HistogramTitleText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Opacity="0.88" />
                    <Button x:Name="HistogramCloseButton"
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            Padding="5"
                            Focusable="False" />
                </Grid>
                <views:HistogramPlotControl x:Name="HistogramPlot"
                                            Height="160"
                                            ClipToBounds="True" />
            </StackPanel>
        </Border>
        <Border x:Name="ColorPickerPanel"
                IsVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="680"
                MaxHeight="430"
                Padding="10,8,10,10"
                CornerRadius="8"
                Background="#E6202020"
                BorderBrush="#604A4A4A"
                BorderThickness="1">
            <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                    <Border x:Name="ColorPickerDragHandle"
                            Grid.Column="0"
                            Width="22"
                            Cursor="SizeAll"
                            Background="Transparent"
                            CornerRadius="3">
                        <TextBlock Text="⠿"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </Border>
                    <TextBlock x:Name="ColorPickerTitleText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Opacity="0.88" />
                    <Button x:Name="ColorPickerCloseButton"
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            Padding="5"
                            Focusable="False" />
                </Grid>
                <Separator Height="1" />
                <Grid ColumnDefinitions="260,1,*" ColumnSpacing="12" MinHeight="300">
                    <StackPanel Grid.Column="0" Spacing="7">
                        <Grid ColumnDefinitions="*,Auto" Height="27">
                            <TextBlock x:Name="ColorPickerRecentText"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Opacity="0.78" />
                            <Button x:Name="ColorPickerClearButton"
                                    Grid.Column="1"
                                    Width="26"
                                    Height="26"
                                    Padding="5"
                                    Focusable="False" />
                        </Grid>
                        <ScrollViewer x:Name="ColorPickerHistoryScroller"
                                      MaxHeight="266"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ColorPickerHistoryRows" Spacing="3" />
                        </ScrollViewer>
                    </StackPanel>
                    <Separator Grid.Column="1" Width="1" />
                    <Grid Grid.Column="2">
                        <TextBlock x:Name="ColorPickerEmptyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                        <StackPanel x:Name="ColorPickerSampleContent"
                                    IsVisible="False"
                                    Spacing="10">
                            <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        Width="86"
                                        Height="86"
                                        CornerRadius="7"
                                        Background="#FF505050"
                                        BorderBrush="#60FFFFFF"
                                        BorderThickness="1">
                                    <Border x:Name="ColorPickerMainSwatch" Margin="3" CornerRadius="5" />
                                </Border>
                                <TextBlock x:Name="ColorPickerDetailedName"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="100,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="9"
                                  RowSpacing="5">
                                <TextBlock x:Name="ColorPickerHexLabel" Grid.Row="0" Grid.Column="0" Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerHexValue" Grid.Row="0" Grid.Column="1" />
                                <TextBlock x:Name="ColorPickerRgbLabel" Grid.Row="1" Grid.Column="0" Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerRgbValue" Grid.Row="1" Grid.Column="1" />
                                <TextBlock x:Name="ColorPickerOklchLabel" Grid.Row="2" Grid.Column="0" Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerOklchValue" Grid.Row="2" Grid.Column="1" />
                                <TextBlock x:Name="ColorPickerHueLabel" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"
                                           Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerHueValue" Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" />
                                <TextBlock x:Name="ColorPickerLightnessLabel" Grid.Row="4" Grid.Column="0"
                                           Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerLightnessValue" Grid.Row="4" Grid.Column="1" />
                                <TextBlock x:Name="ColorPickerChromaLabel" Grid.Row="5" Grid.Column="0" Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerChromaValue" Grid.Row="5" Grid.Column="1" />
                                <TextBlock x:Name="ColorPickerCreativeNameLabel" Grid.Row="6" Grid.Column="0"
                                           Margin="0,7,0,0"
                                           Opacity="0.62" />
                                <TextBlock x:Name="ColorPickerCreativeNameValue"
                                           Grid.Row="6"
                                           Grid.Column="1"
                                           Margin="0,7,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="DropOverlay"
                ZIndex="50"
                IsVisible="False"
                IsHitTestVisible="False"
                Background="#E6131119">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Margin="24"
                    Padding="40,32"
                    CornerRadius="22"
                    Background="#F025212D"
                    BorderBrush="#A17CD7"
                    BorderThickness="2">
                <StackPanel Spacing="12">
                    <Border Width="58" Height="58" CornerRadius="29"
                            HorizontalAlignment="Center"
                            Background="#513A68">
                        <Path x:Name="DropOverlayIcon"
                              Width="26" Height="26"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Fill="#EEE7F7" />
                    </Border>
                    <TextBlock x:Name="DropOverlayText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="ErrorSurface"
                ZIndex="60"
                IsVisible="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Padding="18,12"
                CornerRadius="6"
                Background="#DD181818">
            <TextBlock x:Name="ErrorText"
                       Foreground="#FFF2F2F2"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>