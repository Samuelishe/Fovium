<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Fovium.Views"
             x:Class="Fovium.Views.SettingsPageView">
    <Grid Margin="34,26,24,20" RowDefinitions="Auto,*">
        <ContentControl x:Name="HeaderHost" Margin="0,0,48,0" />
        <views:EdgeFadeScrollViewer x:Name="BodyScroller"
                                    Grid.Row="1"
                                    Margin="0,16,0,0"
                                    BodyMargin="0,4,14,32"
                                    TopFadeBrush="{StaticResource FoviumWindowTopFadeBrush}"
                                    BottomFadeBrush="{StaticResource FoviumWindowBottomFadeBrush}" />
    </Grid>
</UserControl>