<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fovium.Views.ShortcutConflictWindow"
        Classes="fovium-secondary-window"
        Width="470"
        Height="230"
        CanResize="False"
        Background="Transparent">
    <Border Margin="1" Padding="24,20,24,22" Classes="fovium-window-surface">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TitleText" Classes="dialog-title" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Grid.Column="1" Classes="window-close" />
            </Grid>
            <Border Grid.Row="1" Padding="15,13" Classes="fovium-card">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="CancelButton" MinWidth="94" Classes="fovium-button" />
                <Button x:Name="OkButton" MinWidth="94" Classes="fovium-button primary" />
            </StackPanel>
        </Grid>
    </Border>
</Window>