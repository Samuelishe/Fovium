<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fovium.Views.EdgeFadeScrollViewer">
    <UserControl.Styles>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Margin" Value="4,3,0,3" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Theme" Value="{StaticResource FoviumScrollbarThumbTheme}" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ RepeatButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </UserControl.Styles>
    <Grid ClipToBounds="True">
        <ScrollViewer x:Name="ScrollViewport"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="BodyHost" Margin="0,4,14,32"
                            HorizontalContentAlignment="Stretch" />
        </ScrollViewer>
        <Border x:Name="TopFade"
                Height="{StaticResource FoviumEdgeFadeDepth}"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                IsVisible="False" />
        <Border x:Name="BottomFade"
                Height="{StaticResource FoviumEdgeFadeDepth}"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                IsVisible="False" />
    </Grid>
</UserControl>